# Desenvolvimento local: caminho opcional do arquivo libSQL.
ACADEMIA_DB_PATH=

# Produção/Preview: credenciais do banco Turso. Nunca versione valores reais.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Para rodar contas fictícias com `npm run start`, use DEMO_MODE=1.
# `npm run dev` já ativa o modo de demonstração automaticamente.
DEMO_MODE=
DEMO_PASSWORD=

# Na Vercel, configure TURSO_DATABASE_URL e TURSO_AUTH_TOKEN no painel ou CLI.
