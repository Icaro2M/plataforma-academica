# Opcional: caminho do arquivo SQLite. Por padrão: data/academia.sqlite
ACADEMIA_DB_PATH=

# Para rodar contas fictícias com `npm run start`, use DEMO_MODE=1.
# `npm run dev` já ativa o modo de demonstração automaticamente.
DEMO_MODE=
DEMO_PASSWORD=

# Para inicializar uma coordenação fora do modo de demonstração.
# Defina ambos antes do primeiro acesso. A senha precisa ter pelo menos 12 caracteres.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
